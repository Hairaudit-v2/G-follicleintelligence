{
  "phase": "1A.6",
  "programme": "FI-CONTROLLED-PILOT-CONTROL-CENTRE-1A",
  "metricVersion": "1A.6.0",
  "notes": [
    "Rates with zero denominator return null / UI em dash — never invent success.",
    "Live enrolments and live events only; synthetic evidence excluded from live rates.",
    "Automatic Control Centre polling does not count as staff adoption."
  ],
  "metrics": [
    {
      "metricKey": "approved_patients",
      "label": "Approved patients",
      "definition": "Live enrolments in approved-or-later operational statuses.",
      "numerator": "count(live enrolments in approved|invited|activated|active|paused|completed)",
      "denominator": null,
      "eventSources": ["fi_pilot_enrolments"],
      "exclusions": ["synthetic/test evidence classes", "withdrawn", "excluded"],
      "confidenceRule": "insufficient_evidence when liveEnrolments=0",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "consultant", "clinical", "finance", "technical"],
      "emptyStateBehaviour": "0 with insufficient_evidence",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "invited_patients",
      "label": "Invited patients",
      "definition": "Live enrolments invited or past invite (activated/active/paused/completed) or invitedAt set.",
      "numerator": "count(invited live enrolments)",
      "denominator": null,
      "eventSources": ["fi_pilot_enrolments"],
      "exclusions": ["synthetic evidence", "approved-only without invite"],
      "confidenceRule": "insufficient_evidence when liveEnrolments=0",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "consultant", "clinical", "finance", "technical"],
      "emptyStateBehaviour": "0",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "activated_patients",
      "label": "Activated patients",
      "definition": "Live enrolments with activatedAt or activated|active|paused|completed status.",
      "numerator": "count(activated live enrolments)",
      "denominator": null,
      "eventSources": ["fi_pilot_enrolments"],
      "exclusions": ["synthetic evidence"],
      "confidenceRule": "insufficient_evidence when liveEnrolments=0",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "consultant", "clinical", "finance", "technical"],
      "emptyStateBehaviour": "0",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "activation_rate",
      "label": "Activation rate",
      "definition": "Activated ÷ invited among live enrolments.",
      "numerator": "activated_patients",
      "denominator": "invited_patients",
      "eventSources": ["fi_pilot_enrolments"],
      "exclusions": ["synthetic evidence", "approved-only not invited"],
      "confidenceRule": "null + insufficient_evidence when denominator=0",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "consultant", "clinical", "finance", "technical"],
      "emptyStateBehaviour": "— (zero denominator)",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "completion_rate",
      "label": "Completion rate",
      "definition": "Completed ÷ (activated|active|completed) live enrolments.",
      "numerator": "completed_patients",
      "denominator": "activated+active+completed live enrolments",
      "eventSources": ["fi_pilot_enrolments"],
      "exclusions": ["synthetic evidence", "withdrawn"],
      "confidenceRule": "null when denominator=0",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "consultant", "clinical", "finance", "technical"],
      "emptyStateBehaviour": "—",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "journey_completion_rate",
      "label": "Journey completion rate",
      "definition": "Same denominator model as completion_rate for journey reporting.",
      "numerator": "completed_patients",
      "denominator": "activated+active+completed live enrolments",
      "eventSources": ["fi_pilot_enrolments", "journey_milestone_completed"],
      "exclusions": ["synthetic evidence"],
      "confidenceRule": "null when denominator=0; live_partial if milestone events missing",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "consultant", "clinical", "finance", "technical"],
      "emptyStateBehaviour": "—",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "patient_action_completion_rate",
      "label": "Patient action completion rate",
      "definition": "Completed patient actions ÷ (completed + overdue) due outcomes. Optional actions must not dilute.",
      "numerator": "patient_action_completed events",
      "denominator": "patient_action_completed + patient_action_overdue",
      "eventSources": ["patient_action_completed", "patient_action_overdue"],
      "exclusions": ["optional actions without due outcome", "synthetic events", "automatic polling"],
      "confidenceRule": "insufficient_evidence when no live action outcome events",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "consultant", "clinical", "finance", "technical"],
      "emptyStateBehaviour": "— until events exist",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "notification_delivery_rate",
      "label": "Notification delivery rate",
      "definition": "Delivered ÷ (delivered + failed) outcome attempts.",
      "numerator": "notification_delivered",
      "denominator": "notification_delivered + notification_failed",
      "eventSources": ["notification_delivered", "notification_failed", "notification_sent"],
      "exclusions": ["sent-without-outcome rows from success calculation", "synthetic events"],
      "confidenceRule": "insufficient_evidence when outcomes=0; warning delivery_outcome_missing if sent>0",
      "roleVisibility": ["director", "administrator", "clinic_manager", "technical"],
      "emptyStateBehaviour": "—",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "blocker_resolution_rate",
      "label": "Blocker resolution rate",
      "definition": "Resolved blocker events relative to opened/resolved pool and open backlog.",
      "numerator": "blocker_resolved events (or resolved blocker rows)",
      "denominator": "max(opened+resolved events, open+resolved blocker rows)",
      "eventSources": ["blocker_opened", "blocker_resolved", "fi_pilot_blockers"],
      "exclusions": ["synthetic blockers when live-only reporting"],
      "confidenceRule": "insufficient_evidence when no live blockers and no events",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "consultant", "clinical", "finance", "technical"],
      "emptyStateBehaviour": "—",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "manual_fallback_count",
      "label": "Manual channel fallbacks",
      "definition": "Count of manual_channel_fallback_recorded events.",
      "numerator": "count(manual_channel_fallback_recorded)",
      "denominator": null,
      "eventSources": ["manual_channel_fallback_recorded"],
      "exclusions": ["automatic polling"],
      "confidenceRule": "live_partial if event kind never observed in live window",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception"],
      "emptyStateBehaviour": "0 (may indicate missing recording, not zero fallbacks)",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "control_centre_staff_openers",
      "label": "Control Centre staff openers",
      "definition": "Distinct staff actors who viewed overview (excluding automatic polling).",
      "numerator": "distinct actorId on pilot_control_overview_viewed",
      "denominator": null,
      "eventSources": ["pilot_control_overview_viewed"],
      "exclusions": ["metadataClass automatic_refresh|polling|auto_refresh", "missing actorId"],
      "confidenceRule": "insufficient_evidence when no live events",
      "roleVisibility": ["director", "administrator", "clinic_manager", "technical"],
      "emptyStateBehaviour": "0",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "patient_detail_views",
      "label": "Patient detail views",
      "definition": "Count of staff patient detail views excluding automatic polling.",
      "numerator": "count(pilot_control_patient_detail_viewed)",
      "denominator": null,
      "eventSources": ["pilot_control_patient_detail_viewed"],
      "exclusions": ["automatic polling"],
      "confidenceRule": "insufficient_evidence when no live events",
      "roleVisibility": ["director", "administrator", "clinic_manager", "technical"],
      "emptyStateBehaviour": "0",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "export_uses",
      "label": "Export uses",
      "definition": "Count of pilot_control_export_created.",
      "numerator": "count(pilot_control_export_created)",
      "denominator": null,
      "eventSources": ["pilot_control_export_created"],
      "exclusions": ["denied export attempts"],
      "confidenceRule": "live_verified when events present",
      "roleVisibility": ["director", "administrator", "technical"],
      "emptyStateBehaviour": "0",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "clinic_actions_completed",
      "label": "Clinic actions completed",
      "definition": "Count of clinic_action_completed events.",
      "numerator": "count(clinic_action_completed)",
      "denominator": null,
      "eventSources": ["clinic_action_completed"],
      "exclusions": ["synthetic events"],
      "confidenceRule": "live_partial when missing from live window",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "clinical"],
      "emptyStateBehaviour": "0 until emitters hooked",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "overdue_clinic_actions",
      "label": "Overdue clinic actions",
      "definition": "Count of clinic_action_overdue events.",
      "numerator": "count(clinic_action_overdue)",
      "denominator": null,
      "eventSources": ["clinic_action_overdue"],
      "exclusions": ["synthetic events"],
      "confidenceRule": "live_partial when missing",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception"],
      "emptyStateBehaviour": "0 until emitters hooked",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "patients_stalled",
      "label": "Patients stalled",
      "definition": "Count of journey_milestone_blocked + workflow_abandoned events.",
      "numerator": "count(blocked + abandoned events)",
      "denominator": null,
      "eventSources": ["journey_milestone_blocked", "workflow_abandoned"],
      "exclusions": ["synthetic events"],
      "confidenceRule": "live_partial when emitters missing",
      "roleVisibility": ["director", "administrator", "clinic_manager", "reception", "consultant", "clinical"],
      "emptyStateBehaviour": "0 until emitters hooked",
      "implementationStatus": "wired"
    },
    {
      "metricKey": "quotes_delivered",
      "label": "Quotes delivered",
      "definition": "Count of quote_delivered events (may be enriched from clearance snapshot counts).",
      "numerator": "count(quote_delivered) or snapshot enrichment",
      "denominator": null,
      "eventSources": ["quote_delivered", "fi_financial_clearance_snapshots"],
