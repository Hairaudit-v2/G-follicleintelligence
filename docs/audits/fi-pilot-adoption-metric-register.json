      "eventSources": ["pathology_cleared"],
      "exclusions": ["pathology values"],
      "confidenceRule": "live_partial when emitters missing",
      "roleVisibility": ["director", "administrator", "clinic_manager", "clinical"],
      "emptyStateBehaviour": "0",
