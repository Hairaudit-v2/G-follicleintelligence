    },
    {
      "metricKey": "technical_errors",
      "label": "Technical errors",
      "definition": "Count of technical_error_detected events.",
      "numerator": "count(technical_error_detected)",
      "denominator": null,
      "eventSources": ["technical_error_detected", "pilot_control_evaluation_failed"],
      "exclusions": ["PHI payloads"],
      "confidenceRule": "live_partial if only API evaluation failures mapped",
      "roleVisibility": ["director", "administrator", "technical"],
