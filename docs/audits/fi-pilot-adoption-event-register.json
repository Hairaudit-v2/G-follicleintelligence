{
  "phase": "1A.6",
  "programme": "FI-CONTROLLED-PILOT-CONTROL-CENTRE-1A",
  "privacyDefault": "operational_safe",
  "notes": [
    "Events must not carry clinical notes, pathology values, message bodies, document contents, image URLs, or payment instruments.",
